{
  "name": "agzos-code",
  "version": "1.0.0",
  "description": "Agzos Code — editor de código baseado em Electron com Monaco, feito para o time Agzos.",
  "main": "src/main/main.js",
  "author": {
    "name": "Agzos",
    "email": "dev@agzos.local"
  },
  "license": "MIT",
  "homepage": "https://github.com/rodrigoazevedo1988/agzos-code",
  "private": false,
  "scripts": {
    "setup:vendor": "node tools/setup-vendor.js",
    "postinstall": "node tools/setup-vendor.js && node tools/patch-electron-dev-mac.js",
    "build:icons": "electron tools/build-icons.js && node tools/patch-electron-dev-mac.js",
    "start": "electron .",
    "dev": "electron .",
    "dev:tools": "AGZOS_DEV=1 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "release:vps": "node tools/publish-vps-release.js",
    "lint": "eslint .",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "check": "npm run lint && npm run test:unit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "lucide-static": "^1.54.0",
    "marked": "^14.1.4",
    "monaco-editor": "^0.50.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "^4.10.38",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.agzos.code",
    "productName": "Agzos Code",
    "copyright": "Copyright © 2026 Agzos",
    "publish": [
      {
        "provider": "generic",
        "url": "https://code.rsolutionsbr.com/release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!dist/**",
      "!spikes/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,suo,xproj,cc,d.ts}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!node_modules/node-pty/{deps,src,third_party,scripts,typings}/**",
      "!node_modules/node-pty/binding.gyp",
      "!node_modules/node-pty/lib/*.test.js",
      "!node_modules/node-pty/**/*.{pdb,map}",
      "!node_modules/node-pty/node_modules/node-addon-api/**",
      "!node_modules/node-pty/build/{node_gyp_bins,node_modules,deps}/**",
      "!node_modules/node-pty/build/*.{mk,gypi,Makefile}",
      "!node_modules/node-pty/build/Makefile",
      "!node_modules/node-pty/build/Release/{obj,obj.target,.deps}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "portable"
      ],
      "icon": "build/icon.ico",
      "files": [
        "src/**/*",
        "package.json",
        "!node_modules/node-pty/build/**",
        "!node_modules/node-pty/prebuilds/darwin-*/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agzos Code"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "vendor": "Agzos",
      "files": [
        "src/**/*",
        "package.json",
        "!node_modules/node-pty/prebuilds/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "files": [
        "src/**/*",
        "package.json",
        "!node_modules/node-pty/build/**",
        "!node_modules/node-pty/prebuilds/win32-*/**"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    }
  }
}
