{
  "name": "agzos-code",
  "version": "0.1.0",
  "description": "Agzos Code — editor de código baseado em Electron com Monaco, feito para o time Agzos.",
  "main": "src/main/main.js",
  "author": {
    "name": "Agzos",
    "email": "dev@agzos.local"
  },
  "license": "MIT",
  "homepage": "https://github.com/rodrigoazevedo1988/agzos-code",
  "private": false,
  "scripts": {
    "setup:vendor": "node tools/setup-vendor.js",
    "postinstall": "node tools/setup-vendor.js && node tools/patch-electron-dev-mac.js",
    "build:icons": "electron tools/build-icons.js && node tools/patch-electron-dev-mac.js",
    "start": "electron .",
    "dev": "electron .",
    "dev:tools": "AGZOS_DEV=1 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "lint": "eslint .",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "check": "npm run lint && npm run test:unit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  },
  "dependencies": {
    "lucide-static": "^1.54.0",
    "monaco-editor": "^0.50.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.agzos.code",
    "productName": "Agzos Code",
    "copyright": "Copyright © 2026 Agzos",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,suo,xproj,cc,d.ts}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agzos Code"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "vendor": "Agzos"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    }
  }
}
